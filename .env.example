# `make env` copies this file to .env and replaces every "generate" with a random secret.
# Docker Compose and the app both read .env. Variables left out fall back to the defaults
# documented in the README.

# --- App -------------------------------------------------------------------------------------
# development | test | production (production hides /docs, /redoc and /openapi.json)
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth ------------------------------------------------------------------------------------
# At least 32 random characters. Anyone who knows it can forge access tokens.
JWT_SECRET=generate
# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
# Access token lifetime, 1 to 1440 minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Requests per minute and client IP on each auth endpoint (login, register, verify).
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- HTTP ------------------------------------------------------------------------------------
# Larger request bodies are rejected with 413 (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Database --------------------------------------------------------------------------------
POSTGRES_USER=todo
POSTGRES_PASSWORD=generate
POSTGRES_DB=todo
# Only used when the API runs on the host (`make run`). Inside Docker, Compose builds the
# URL from the POSTGRES_* values above. If you change POSTGRES_PORT, change the port here.
DATABASE_URL=postgresql+psycopg://todo:generate@localhost:5432/todo

# --- Docker host ports -----------------------------------------------------------------------
# Change them if 8000/5432 are already taken on your machine.
API_PORT=8000
POSTGRES_PORT=5432

# --- Optional --------------------------------------------------------------------------------
# Dev mode (`make dev`): polling makes hot reload work on any Docker host. On native Linux
# you can set it to false to save a little CPU.
# WATCHFILES_FORCE_POLLING=true
# Password of the demo accounts created by `make seed` (default: Password123!).
# SEED_PASSWORD=Password123!
